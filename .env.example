# Primary: Groq — https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxx
PREFER_GROQ_TRANSCRIBE=true
PREFER_GROQ_CHAT=true
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional fallback — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
# Embeddings use local FastEmbed by default (no API). Set USE_GEMINI_EMBEDDINGS=true to try Gemini.
# USE_GEMINI_EMBEDDINGS=false
# Faster chat when Groq key is set (default on)
# PREFER_GROQ_CHAT=true
MAX_UPLOAD_MB=25
